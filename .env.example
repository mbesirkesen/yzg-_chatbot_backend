# İleride gerçek LLM entegrasyonu için
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant
# ANTHROPIC_API_KEY=

# CORS: virgülle ayrılmış origin listesi; boş bırakılırsa varsayılan kullanılır
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Chroma (APP_* kullanın; genel CHROMA_PERSIST_DIR ile çakışma olmasın)
# APP_CHROMA_PERSIST_DIR=./turkish_cuisine_db
# APP_CHROMA_COLLECTION_NAME=turkish_cuisine
