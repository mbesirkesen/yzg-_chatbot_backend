# LLM sağlayıcısı: mock | groq | anthropic  (varsayılan: mock)
LLM_PROVIDER=mock

# Groq (LLM_PROVIDER=groq ise gerekli)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic / Claude (LLM_PROVIDER=anthropic ise gerekli)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ChromaDB (APP_* öneki; ortam genelindeki CHROMA_PERSIST_DIR ile çakışmaz)
APP_CHROMA_PERSIST_DIR=./turkish_cuisine_db
APP_CHROMA_COLLECTION_NAME=turkish_cuisine

# Embedding modeli (varsayılan: intfloat/multilingual-e5-small)
# EMBEDDING_MODEL=intfloat/multilingual-e5-small

# RAG varsayılan sonuç sayısı, 1-50 (varsayılan: 5)
# DEFAULT_TOP_K=5

# CORS: virgülle ayrılmış origin listesi veya * (herkese açık)
CORS_ORIGINS=*
